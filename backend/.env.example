SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-public-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Required for custom signed sessions; replace with 32+ random bytes encoded as base64url.
# Generate with: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=replace-with-random-base64url-secret
# Optional but recommended: a separate stable secret for long-lived lease document QR links.
# Set once before generating links; keep unchanged. Generate with the command above.
LEASE_DOCUMENT_TOKEN_SECRET=replace-with-a-different-random-base64url-secret
# Set true only for local development with UUID user IDs and active user records.
RIIROOW_LOCAL_AUTH=false
PORT=5000
